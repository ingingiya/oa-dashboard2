{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/sync-products?secret=${ERP_SYNC_SECRET}",
      "schedule": "7 0 * * *"
    },
    {
      "path": "/api/sync-beauty?secret=${ERP_SYNC_SECRET}",
      "schedule": "12 0 * * *"
    },
    {
      "path": "/api/sync-ads?secret=${ERP_SYNC_SECRET}",
      "schedule": "17 0 * * *"
    },
    {
      "path": "/api/sync-naver-ads?secret=${ERP_SYNC_SECRET}",
      "schedule": "22 0 * * *"
    },
    {
      "path": "/api/hypothesis?action=generate",
      "schedule": "10 0 * * *"
    },
    {
      "path": "/api/weekly-report",
      "schedule": "30 23 * * 0"
    },
    {
      "path": "/api/daily-alert",
      "schedule": "40 23 * * *"
    },
    {
      "path": "/api/monthly-review",
      "schedule": "0 1 1 * *"
    },
    {
      "path": "/api/meta-schedule?action=cron&secret=${ERP_SYNC_SECRET}",
      "schedule": "3 * * * *"
    }
  ]
}
